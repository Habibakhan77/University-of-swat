# ---------- Dependencies ----------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases

# ---------- Environment / secrets ----------
.env
.env.*
!.env.example
*.pem
*.key

# ---------- Next.js (frontend) ----------
frontend/.next/
frontend/out/
frontend/build/
next-env.d.ts
*.tsbuildinfo

# ---------- Strapi (cms) ----------
cms/.tmp/
cms/.cache/
cms/.strapi/
cms/build/
cms/dist/
cms/exports/
cms/types/generated/
# Uploaded media lives in the DB/volume, not git (seed assets go in cms/seed/assets)
cms/public/uploads/*
!cms/public/uploads/.gitkeep
*.sqlite
*.db

# ---------- Testing / tooling ----------
coverage/
.nyc_output/
playwright-report/
test-results/
.lighthouseci/
.eslintcache
.turbo/
.vercel/

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Docker / local data ----------
docker-data/
pgdata/
*.dump
*.backup

# ---------- OS / editor ----------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*~

# ---------- Claude Code local settings ----------
.claude/settings.local.json

# ---------- Local-only files ----------
