# =====================================================================================
# docker-compose settings (production server, or the local Docker stack).
# Copy to .env next to docker-compose.yml and fill in. Never commit .env.
#
# Generate every secret below in one go (prints ready-to-paste lines):
#   node -e "const r=()=>require('crypto').randomBytes(32).toString('base64url');console.log(['APP_KEYS='+[r(),r(),r(),r()].join(','),...['API_TOKEN_SALT','ADMIN_JWT_SECRET','TRANSFER_TOKEN_SALT','JWT_SECRET','ENCRYPTION_KEY','POSTGRES_PASSWORD','REVALIDATE_SECRET','CONTACT_FORM_SECRET'].map(k=>k+'='+r())].join('\n'))"
# (or replace node with: docker run --rm node:22-alpine node -e "...")
#
# For local development without Docker, use cms/.env and frontend/.env.local instead.
# =====================================================================================

# --- Compose ---------------------------------------------------------------------------
# On the SERVER keep this line, so docker-compose.override.yml (local only) is ignored.
# On a laptop running the local Docker stack, delete it.
COMPOSE_FILE=docker-compose.yml

# --- Public addresses (no trailing slash) ---------------------------------------------------
# The website. Used for canonical links, sitemap.xml, Open Graph and structured data.
# Baked into the website image at build time: rebuild the frontend after changing it.
SITE_URL=https://uswat.edu.pk
# Strapi (admin panel, API, media). Nginx serves it on the "cms." subdomain of SITE_URL.
# Also baked into the website image (media URLs, allowed image host).
# Local Docker stack: SITE_URL=http://localhost:8080 and CMS_URL=http://cms.localhost:8081
CMS_URL=https://cms.uswat.edu.pk

# --- PostgreSQL ----------------------------------------------------------------------------
# Created on the first start of the postgres container (changing them later does not rename
# an existing database or user).
POSTGRES_DB=uswat
POSTGRES_USER=uswat
# Required. Long random value; Strapi connects with it over the internal Docker network only.
POSTGRES_PASSWORD=

# --- Strapi secrets (all required) -------------------------------------------------------
# Session keys for Strapi's server: four comma-separated random values.
APP_KEYS=
# Salt for hashing API tokens created in Settings > API Tokens.
API_TOKEN_SALT=
# Signs admin panel logins. Changing it signs every editor out.
ADMIN_JWT_SECRET=
# Salt for data-transfer tokens (strapi transfer, used to copy content between servers).
TRANSFER_TOKEN_SALT=
# Signs Users & Permissions (public API) tokens.
JWT_SECRET=
# Encrypts stored secrets such as API tokens shown again in the admin. Never change it after setup.
ENCRYPTION_KEY=

# --- Website <-> Strapi -----------------------------------------------------------------
# Required. Strapi sends it to the website when content is published, so pages update at once.
REVALIDATE_SECRET=
# The website server signs contact-form submissions with it. Empty = REVALIDATE_SECRET is used.
CONTACT_FORM_SECRET=
# Optional read-only Strapi API token for the website. Content is public, so normally empty.
STRAPI_API_TOKEN=

# --- Maintenance ------------------------------------------------------------------------
# Set to true for ONE restart to reset the Media Cell / Department Editor roles to their
# defaults, then set it back to false.
SYNC_ADMIN_ROLES=false
