{
  "kind": "singleType",
  "collectionName": "admissions_pages",
  "info": {
    "singularName": "admissions-page",
    "pluralName": "admissions-pages",
    "displayName": "Admissions Page",
    "description": "Admissions hub. Programs, FAQs (categories admissions, fees, scholarships) and offices come from their own types. Leave a section empty rather than guessing: the page then shows the “Check the latest admission advertisement” notice."
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "title": { "type": "string", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "intro": { "type": "text", "pluginOptions": { "i18n": { "localized": true } } },
    "heroImage": { "type": "media", "multiple": false, "allowedTypes": ["images"], "pluginOptions": { "i18n": { "localized": false } } },
    "applyUrl": { "type": "string", "pluginOptions": { "i18n": { "localized": false } } },
    "banner": { "type": "component", "component": "shared.cta", "repeatable": false, "pluginOptions": { "i18n": { "localized": true } } },
    "advertisement": { "type": "component", "component": "shared.link", "repeatable": false, "pluginOptions": { "i18n": { "localized": true } } },
    "missingInfoNotice": { "type": "component", "component": "shared.cta", "repeatable": false, "pluginOptions": { "i18n": { "localized": true } } },
    "importantDates": { "type": "component", "component": "admissions.important-date", "repeatable": true, "pluginOptions": { "i18n": { "localized": true } } },
    "howToApply": { "type": "component", "component": "admissions.step", "repeatable": true, "pluginOptions": { "i18n": { "localized": true } } },
    "meritLists": { "type": "component", "component": "shared.link", "repeatable": true, "pluginOptions": { "i18n": { "localized": true } } },
    "eligibility": { "type": "blocks", "pluginOptions": { "i18n": { "localized": true } } },
    "feeNote": { "type": "blocks", "pluginOptions": { "i18n": { "localized": true } } },
    "feeLinks": { "type": "component", "component": "shared.link", "repeatable": true, "pluginOptions": { "i18n": { "localized": true } } },
    "scholarships": { "type": "blocks", "pluginOptions": { "i18n": { "localized": true } } },
    "contactOffices": { "type": "relation", "relation": "oneToMany", "target": "api::office.office" },
    "seo": { "type": "component", "component": "shared.seo", "repeatable": false, "pluginOptions": { "i18n": { "localized": true } } }
  }
}
