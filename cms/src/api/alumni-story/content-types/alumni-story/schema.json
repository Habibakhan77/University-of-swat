{
  "kind": "collectionType",
  "collectionName": "alumni_stories",
  "info": {
    "singularName": "alumni-story",
    "pluralName": "alumni-stories",
    "displayName": "Alumni Story",
    "description": "A graduate of a department and what they do now. Only with the graduate’s consent."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "graduationYear": {
      "type": "integer",
      "min": 1950,
      "max": 2100,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "program": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "currentRole": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "organization": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "story": {
      "type": "blocks",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "sourceUrl": {
      "type": "string",
      "regex": "^https://\\S+$",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "order": {
      "type": "integer",
      "default": 0,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "department": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::department.department",
      "inversedBy": "alumniStories"
    }
  }
}
