{
  "kind": "collectionType",
  "collectionName": "jobs",
  "info": {
    "singularName": "job",
    "pluralName": "jobs",
    "displayName": "Job"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "referenceNumber": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "state": {
      "type": "enumeration",
      "enum": [
        "open",
        "closed",
        "cancelled"
      ],
      "required": true,
      "default": "open",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "jobType": {
      "type": "enumeration",
      "enum": [
        "faculty",
        "administrative",
        "project",
        "contract",
        "internship"
      ],
      "required": true,
      "default": "faculty",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "positions": {
      "type": "integer",
      "min": 1,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "summary": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "blocks",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "publishDate": {
      "type": "date",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "lastDate": {
      "type": "datetime",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "applyUrl": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "documents": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "files",
        "images"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "department": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::department.department",
      "inversedBy": "jobs"
    },
    "office": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::office.office",
      "inversedBy": "jobs"
    }
  }
}
