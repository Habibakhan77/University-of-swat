{
  "kind": "singleType",
  "collectionName": "contact_pages",
  "info": {
    "singularName": "contact-page",
    "pluralName": "contact-pages",
    "displayName": "Contact Page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "intro": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "areaCode": {
      "type": "string",
      "maxLength": 8,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "directorySourceUrl": {
      "type": "string",
      "regex": "^https://",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "mapQuery": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "keyOffices": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::office.office"
    },
    "formIntro": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
