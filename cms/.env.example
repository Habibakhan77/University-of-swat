# Strapi settings for local development (`npm run dev`). Copy to .env and fill in. Never commit .env.
# In Docker these come from the root .env through docker-compose.yml instead.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# ---------- Server ----------
HOST=0.0.0.0
PORT=1337
# Public URL of Strapi, e.g. https://cms.uswat.edu.pk. Leave empty locally.
PUBLIC_URL=
# true behind Nginx/Cloudflare: trusts X-Forwarded-* so secure admin cookies work over HTTPS.
IS_PROXIED=false

# ---------- Secrets (required) ----------
# Four comma-separated random values (session keys)
APP_KEYS="toBeModified1,toBeModified2,toBeModified3,toBeModified4"
# Salt for API tokens (Settings > API Tokens)
API_TOKEN_SALT=tobemodified
# Signs admin panel logins; changing it signs every editor out
ADMIN_JWT_SECRET=tobemodified
# Salt for data-transfer tokens (strapi transfer)
TRANSFER_TOKEN_SALT=tobemodified
# Signs Users & Permissions tokens
JWT_SECRET=tobemodified
# Encrypts stored secrets; never change it after setup
ENCRYPTION_KEY=tobemodified

# ---------- Database (local dev: native PostgreSQL 17) ----------
# postgres | mysql | sqlite
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=uswat
DATABASE_USERNAME=uswat
DATABASE_PASSWORD=change-me
DATABASE_SCHEMA=public
# Optional: one connection string instead of the values above (postgres://user:pass@host:5432/db)
# DATABASE_URL=
# Connection pool size and how long to wait for a free connection (ms)
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT=60000
# TLS to the database (only for a managed/remote PostgreSQL)
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Paths or PEM contents for DATABASE_SSL=true (leave empty if not needed)
# DATABASE_SSL_KEY=
# DATABASE_SSL_CERT=
# DATABASE_SSL_CA=
# DATABASE_SSL_CAPATH=
# DATABASE_SSL_CIPHER=
# Only for DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# ---------- Admin panel ----------
# Open the admin panel in a browser on `npm run dev`
ADMIN_AUTO_OPEN=false
# Strapi's in-admin survey, Enterprise promotion and documentation links
FLAG_NPS=true
FLAG_PROMOTE_EE=true
FLAG_DOC_LINKS=true
# Set to true for one boot to reset the Media Cell / Department Editor roles to their defaults
SYNC_ADMIN_ROLES=false

# ---------- Website integration ----------
# On-demand revalidation: Strapi calls the website when content changes, so edits appear at once.
# Use the same REVALIDATE_SECRET in frontend/.env.local. Leave empty to skip (the site then refreshes hourly).
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=
# Contact form: the website server signs each submission with this secret (same value in
# frontend/.env.local). If empty, REVALIDATE_SECRET is used. Without either, the form is switched off.
CONTACT_FORM_SECRET=
# Include related entries in webhook payloads (not needed by the website)
WEBHOOKS_POPULATE_RELATIONS=false
# Don't send anonymous usage data to Strapi
STRAPI_TELEMETRY_DISABLED=true
