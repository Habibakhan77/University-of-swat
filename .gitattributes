# Normalize line endings: LF in the repo and working tree (the app runs in Linux containers)
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.avif binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary
