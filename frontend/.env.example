# Strapi base URL used by the Next.js server (inside Docker: http://cms:1337)
STRAPI_URL=http://localhost:1337
# Public base URL for Strapi media (/uploads/...) as seen by browsers
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
# Optional read-only API token (website content is public, so normally empty)
STRAPI_API_TOKEN=
# Public URL of this website (canonical links, Open Graph, structured data)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared with Strapi (cms/.env): Strapi sends it when content changes so pages refresh at once
REVALIDATE_SECRET=
# Contact form: shared with Strapi (cms/.env). If empty, REVALIDATE_SECRET is used.
CONTACT_FORM_SECRET=
# Set to 1 only to test a production build (next start) against Strapi on localhost/a private address:
# next/image refuses private IPs in production otherwise. Leave empty when Strapi media has a public URL.
IMAGES_ALLOW_LOCAL_IP=
