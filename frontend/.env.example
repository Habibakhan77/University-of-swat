# Website settings for local development (`npm run dev`). Copy to .env.local. Never commit it.
# In Docker these come from the root .env through docker-compose.yml instead.
# NEXT_PUBLIC_* values are inlined at build time: rebuild after changing them.

# Strapi base URL used by the Next.js server (inside Docker: http://cms:1337)
STRAPI_URL=http://localhost:1337
# Public base URL for Strapi media (/uploads/...) as seen by browsers; also the host next/image may optimise
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
# Optional read-only API token (website content is public, so normally empty)
STRAPI_API_TOKEN=
# Public URL of this website (canonical links, Open Graph, sitemap, structured data)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared with Strapi (cms/.env): Strapi sends it when content changes so pages refresh at once
REVALIDATE_SECRET=
# Contact form: shared with Strapi (cms/.env). If empty, REVALIDATE_SECRET is used.
CONTACT_FORM_SECRET=
# Set to 1 only to test a production build (next start) against Strapi on localhost/a private address:
# next/image refuses private IPs in production otherwise. Leave empty when Strapi media has a public URL.
IMAGES_ALLOW_LOCAL_IP=
# Set to 1 to build the self-contained server in .next/standalone (the Docker image does this)
BUILD_STANDALONE=
# Don't send anonymous usage data to Vercel
NEXT_TELEMETRY_DISABLED=1
